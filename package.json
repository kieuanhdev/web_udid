{
  "name": "ios-udid-web",
  "version": "1.0.0",
  "description": "Website lấy UDID thiết bị iOS tức thì qua Apple Profile Service",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/test-core.js && node test/test-server.js",
    "clean": "node -e 'fs.rmSync(\"scratch\", { recursive: true, force: true })'"
  },
  "keywords": [
    "ios",
    "udid",
    "mobileconfig",
    "profile-service",
    "apple"
  ],
  "dependencies": {
    "node-forge": "^1.3.1",
    "plist": "^3.1.0"
  },
  "license": "ISC"
}

